node_modules/
dist/
*.log
.DS_Store

# Scratch files left behind by driving the agent against this repo while testing.
*-probe.txt
*-demo.txt
test-*.txt

# /export writes here by default; exports are yours, not the repo's.
codegoblin-*.md
model_test/

# Generated images, audio and 3D models are output, not source.
codegoblin-output/

# Files carved off the lost drive. Mostly NUL bytes and pieces of unrelated
# files, so they must never reach a commit - and bun test runs whatever it
# finds, which is why the test script skips them too.
_RECOVERED_LOCAL_*/
_RECOVERED_LOCAL_*.txt

# Test workspaces, CODEGOBLIN_DIR profiles and screenshots from user passes.
# Profiles hold auth.json once a key is connected, so they must never be staged.
/output/
.playwright-cli/
