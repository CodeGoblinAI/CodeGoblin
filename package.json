{
  "name": "codegoblin",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local-first AI coding agent with image, 3D and voice generation.",
  "license": "MIT",
  "bin": {
    "codegoblin": "src/cli/main.ts",
    "cg": "src/cli/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "bun src/cli/main.ts",
    "build": "bun script/build.ts",
    "tui": "bun src/tui/app.ts",
    "web": "bun src/web/serve.ts",
    "prompt": "bun src/cli/prompt.ts",
    "test": "bun test \"--path-ignore-patterns=**/_RECOVERED_LOCAL_*/**\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@cursor/sdk": "1.0.35",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "2.0.1"
  }
}
